          <ID>1032</ID>
          <Description>"01. Export Mono class+field+method report -&gt; TEMP (v0.1.2)"</Description>
          <VariableType>Auto Assembler Script</VariableType>
          <AssemblerScript>[ENABLE]
{$lua}
if syntaxcheck then return '' end
local ok,err=xpcall(function()
  assert(ROWS and type(ROWS.dumpMono)=='function', 'ROWS table Lua was not initialized. Reopen the CT and allow its Lua script.')
  ROWS.dumpMono()
end, function(e)
  return (debug and debug.traceback) and debug.traceback(tostring(e),2) or tostring(e)
end)
if not ok then
  print('[ROWS] Mono diagnostic launcher ERROR: '..tostring(err))
  showMessage('[ROWS] Diagnostic could not run. Open CE Lua Engine to inspect details.\n'..tostring(err))
end
return ''
{$asm}

[DISABLE]
</AssemblerScript>
